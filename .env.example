# Estas variables se configuran en Vercel (Project > Settings > Environment Variables).
# Para pruebas locales cópialo como ".env". NUNCA subas .env a GitHub.

# --- Mercado Libre (DevCenter > tu aplicación) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Idéntica a la "URI de redirect" registrada en la aplicación
ML_REDIRECT_URI=https://TU-PROYECTO.vercel.app/auth/callback
ML_SITE=MLC
ML_AUTH_HOST=https://auth.mercadolibre.cl
ML_USE_PKCE=1
# 1 = bloquea TODA escritura (modo solo lectura)
ML_READ_ONLY=0
# Recomendado: id numérico de tu cuenta de Mercado Libre; si la autorización llega con otra cuenta, no se guarda
ML_EXPECTED_USER_ID=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://TU-REF.supabase.co
# Clave secreta de servidor (service_role / sb_secret_...). Solo en Vercel, jamás en el navegador.
SUPABASE_SERVICE_KEY=

# --- Seguridad del servidor (genera cada una con: openssl rand -hex 32) ---
# Token que Claude Code envía en el header Authorization: Bearer ...
MCP_BEARER_TOKEN=
# Clave para abrir /auth/start una sola vez (puedes borrarla después de autorizar)
AUTH_SETUP_KEY=
# Secreto de la tarea diaria /cron/keepalive (Vercel lo envía solo). Evita que Supabase
# se pause por inactividad y mantiene renovado el token de Mercado Libre.
CRON_SECRET=
